API_KEY=5ae2e3f221c38a28845f05b686f69838eab47a77852ceed62a3dfec3

# Your Paymob API Key
PAYMOB_API_KEY=

# Card Payment Integration ID
PAYMOB_CARD_INTEGRATION_ID=

# Mobile Wallet Integration ID — paste yours here when ready
PAYMOB_WALLET_INTEGRATION_ID=

# iFrame ID
PAYMOB_IFRAME_ID=

# HMAC Secret — Dashboard → Settings → Account Info
PAYMOB_HMAC_SECRET=

# Base API URL (do not change unless Paymob updates it)
PAYMOB_BASE_URL=https://accept.paymob.com/api

# Currency code (Egypt = EGP)
PAYMENT_CURRENCY=EGP

# Payment key expiration in seconds (3600 = 1 hour)
PAYMENT_KEY_EXPIRATION=3600

# App environment: development | production
APP_ENV=development
